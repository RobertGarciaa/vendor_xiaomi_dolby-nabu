//
// Dolby Atmos (Nabu HyperOS hardware DAP) vendor components.
//
// Blob provenance is recorded in proprietary-files.txt and README.md.
// The nabu effects factory runs in the 32-bit audio HAL service. Ship
// both ABIs for DAP and its client dependencies; DMS itself remains 64-bit.
// Keep the device audio HAL unchanged.
//

soong_namespace {
}

cc_prebuilt_library_shared {
    name: "libdapparamstorage",
    owner: "xiaomi",
    strip: {
        none: true,
    },
    target: {
        android: {
            shared_libs: [
                "libcutils",
                "libutils",
                "liblog",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    arch: {
        arm: {
            srcs: ["proprietary/vendor/lib/libdapparamstorage.so"],
        },
        arm64: {
            srcs: ["proprietary/vendor/lib64/libdapparamstorage.so"],
        },
    },
    compile_multilib: "both",
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "libdlbdsservice",
    owner: "xiaomi",
    strip: {
        none: true,
    },
    target: {
        android: {
            srcs: [
                ":nabu_dms_compat_consumer",
            ],
            shared_libs: [
                "libutils",
                "libsf_dolby_nabu",
                "liblog",
                "libxml2",
                "libcrypto",
                "libdapparamstorage",
                "libsqlite",
                "libhidlbase",
                "vendor.dolby.hardware.dms@2.0",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "vendor.dolby.hardware.dms@2.0",
    owner: "xiaomi",
