// Nabu MiSound with MIUI compatibility shims, prepared by tools/import-misound.sh.
android_app_import {
    name: "MiSound",
    owner: "xiaomi",
    apk: "proprietary/ported/product/app/MiSound/MiSound.apk",
    certificate: "platform",
    privileged: false,
    dex_preopt: {
        enabled: false,
    },
    // The APK already contains a patched classes.dex and a shim classes2.dex;
    // preopting a hand-patched multidex APK adds risk without benefit.
    presigned: false,
    product_specific: true,
}

// DMS was built against AHandler's VNDK30 layout. Isolate its original
// provider instead of letting Android 17 write new fields into the old object.
python_binary_host {
    name: "nabu_dms_foundation_fixup",
    main: "tools/dms_foundation_compat.py",
    srcs: ["tools/dms_foundation_compat.py"],
}

genrule {
    name: "nabu_dms_compat_consumer",
    tools: ["nabu_dms_foundation_fixup"],
    srcs: ["proprietary/vendor/lib64/libdlbdsservice.so"],
    out: ["libdlbdsservice.so"],
    cmd: "$(location nabu_dms_foundation_fixup) --mode consumer --input $(in) --output $(out)",
}

genrule {
    name: "nabu_dms_compat_provider",
    tools: ["nabu_dms_foundation_fixup"],
    srcs: ["proprietary/compat/vndk30/lib64/libstagefright_foundation.so"],
    out: ["libsf_dolby_nabu.so"],
    cmd: "$(location nabu_dms_foundation_fixup) --mode provider --input $(in) --output $(out)",
}

cc_prebuilt_library_shared {
    name: "libsf_dolby_nabu",
    owner: "xiaomi",
    srcs: [":nabu_dms_compat_provider"],
    shared_libs: [
        "libutils",
        "libcutils",
        "liblog",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    prefer: true,
    soc_specific: true,
}

// Pad 5 stock input settings. Generated APKs preserve original resources/assets.
android_app_import {
    name: "NabuMiuiInputSettings",
    apk: "proprietary/ported/product/app/MiuiInputSettings/MiuiInputSettings.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    enforce_uses_libs: false,
    dex_preopt: {
        enabled: false,
    },
}

// Only stock stylus/keyboard OTA services are exposed; Bluetooth itself is AOSP.
android_app_import {
    name: "NabuStylusOta",
    apk: "proprietary/ported/system_ext/priv-app/NabuStylusOta/NabuStylusOta.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    uses_libs: ["org.apache.http.legacy"],
    dex_preopt: {
        enabled: false,
    },
}

cc_prebuilt_library_shared {
    name: "nabu_touchfeature_interface",
    // Retain the stock ABI for reference/link checks only. hardware/xiaomi owns
    // the installed interface with this SONAME, even when the stock HAL is off.
    installable: false,
    stem: "vendor.xiaomi.hardware.touchfeature@1.0",
    arch: {
        arm: {
            srcs: ["proprietary/vendor/lib/vendor.xiaomi.hardware.touchfeature@1.0.so"],
        },
        arm64: {
            srcs: ["proprietary/vendor/lib64/vendor.xiaomi.hardware.touchfeature@1.0.so"],
        },
    },
    compile_multilib: "both",
    shared_libs: [
        "libhidlbase",
        "libhidltransport",
        "libutils",
        "liblog",
        "libcutils",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    strip: {
        none: true,
    },
    vendor: true,
}

cc_prebuilt_library_shared {
    name: "nabu_touchfeature_impl",
    stem: "vendor.xiaomi.hardware.touchfeature@1.0-impl",
    srcs: ["proprietary/vendor/lib64/hw/vendor.xiaomi.hardware.touchfeature@1.0-impl.so"],
    compile_multilib: "64",
    shared_libs: [
        "nabu_touchfeature_interface",
        "libhidlbase",
        "libhidltransport",
        "libutils",
        "liblog",
        "libcutils",
        "libhardware",
        "libbase",
        "libbinder",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    relative_install_path: "hw",
    strip: {
        none: true,
    },
    vendor: true,
}

cc_prebuilt_binary {
    name: "nabu_touchfeature_hal",
    stem: "vendor.xiaomi.hardware.touchfeature@1.0-service",
    srcs: ["proprietary/vendor/bin/hw/vendor.xiaomi.hardware.touchfeature@1.0-service"],
    compile_multilib: "64",
    shared_libs: [
        "nabu_touchfeature_interface",
        "libhidlbase",
        "libhidltransport",
        "libutils",
        "liblog",
        "libcutils",
        "libhardware",
        "libbase",
        "libbinder",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    required: ["nabu_touchfeature_impl"],
    relative_install_path: "hw",
    init_rc: ["input/configs/touchfeature.rc"],
    vintf_fragments: ["input/configs/touchfeature-manifest.xml"],
    strip: {
        none: true,
    },
    vendor: true,
}

hidl_package_root {
    name: "vendor.pixelos.nabu",
    path: "vendor/xiaomi/dolby-nabu/input/interfaces",
}

java_library {
    name: "nabu_keyboard_auth",
    srcs: ["input/usb/src/**/*.java"],
    installable: false,
}

// Deliberately absent from PRODUCT_PACKAGES until the MTD/TEE service chain is ported.
android_app_import {
    name: "NabuMiDevAuth",
    apk: "proprietary/ported/system_ext/priv-app/NabuMiDevAuth/NabuMiDevAuth.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    dex_preopt: { enabled: false },
}

cc_binary {
    name: "nabu_input_control_service",
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "input/control/Control.cpp",
        "input/control/service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libhidlbase",
        "libutils",
        "vendor.pixelos.nabu.input@1.0",
    ],
    header_libs: ["libcutils_headers"],
    init_rc: ["input/configs/input-control.rc"],
    vintf_fragments: ["input/configs/input-control-manifest.xml"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

// Qualcomm DSP firmware, not an application-processor shared library.
prebuilt_rfsa {
    name: "nabu_dolby_capi_v2_dap_cpdp",
    owner: "xiaomi",
    src: "proprietary/vendor/lib/rfsa/adsp/capi_v2_dap_cpdp.so",
    filename: "capi_v2_dap_cpdp.so",
    relative_install_path: "adsp",
    soc_specific: true,
}

// Stock libqtigef resolves the audio HAL through a hard-coded platform string,
// building "/vendor/lib/hw/audio.primary.%s.so" with "msmnile". nabu's only
// stock HAL is installed as audio.primary.nabu.so, so that lookup failed and
// gef_set_param_v1 returned -38 (no HAL transfer function).
//
// Two candidate fixes exist: install a compatibility symlink at
// audio.primary.msmnile.so, or retarget the GEF lookup. The symlink collides
// with the qcom-caf source HAL, which also installs to that exact path (Kati:
// "overriding commands for target vendor/lib/hw/audio.primary.msmnile.so"), and
// it risks dlopen'ing a second HAL instead of the one AudioFlinger owns.
//
// Retargeting the literal is the safe option: GEF then asks for
// /vendor/lib/hw/audio.primary.nabu.so, which AudioFlinger already loaded, so
// dlopen returns that same handle and the GEF session shares the HAL's device
// context. The tool asserts the output hash, and the patch is offset-neutral:
// only the string contents change, not a single instruction.
python_binary_host {
    name: "nabu_gef_hal_lookup_fixup",
    main: "tools/gef_hal_lookup_compat.py",
    srcs: ["tools/gef_hal_lookup_compat.py"],
}

genrule {
    name: "nabu_gef_hal_lookup_nabu",
    tools: ["nabu_gef_hal_lookup_fixup"],
    srcs: ["proprietary/vendor/lib/libqtigef.so"],
    out: ["libqtigef.so"],
    cmd: "$(location nabu_gef_hal_lookup_fixup) --input $(in) --output $(out)",
}

// nabu-only replacement for the shared sm8150-common libqtigef: same stem, so
// the installed path stays /vendor/lib/libqtigef.so, which both the stock HAL
// (dlopen "libqtigef.so") and libhwdap expect. sm8150-common-vendor.mk skips
// libqtigef from the product list. Complementary enabled conditions also
// disable the unused Soong module, preventing duplicate Kati install rules.
cc_prebuilt_library_shared {
    name: "libqtigef_nabu",
    enabled: select(soong_config_variable("nabu_dolby", "replace_qtigef"), {
        true: true,
        default: false,
    }),
    owner: "xiaomi",
    stem: "libqtigef",
    srcs: [":nabu_gef_hal_lookup_nabu"],
    shared_libs: [
        "liblog",
        "libcutils",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    compile_multilib: "32",
    strip: {
        none: true,
    },
    prefer: true,
    soc_specific: true,
}
