# SPDX-License-Identifier: Apache-2.0
# crDroid nabu kernel ABI. Persisted choices override the first-boot defaults.
# Select firmware before enabling pen reports. No screen-cycle is forced here.
on boot
    chown system system /sys/touchpanel/pen
    chown system system /sys/touchpanel/pen_gen2_force
    chown system system /sys/devices/platform/soc/soc:xiaomi_keyboard/xiaomi_keyboard_conn_status
    write /sys/touchpanel/pen_gen2_force ${persist.vendor.nabu.input.pen_gen2:-0}
    write /sys/touchpanel/pen ${persist.vendor.nabu.input.pen:-1}
    write /sys/devices/platform/soc/soc:xiaomi_keyboard/xiaomi_keyboard_conn_status ${persist.vendor.nabu.input.keyboard:-enable_keyboard}
